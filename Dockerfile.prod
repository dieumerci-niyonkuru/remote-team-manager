# =============================================================================
# RemoteTeam Manager — Production Dockerfile
# Three-stage build:
#   1. frontend  — Node 20, npm ci + npm run build  → dist/
#   2. builder   — Python 3.11, compile all wheels
#   3. final     — lean Python runtime + Django + built React frontend
#
# Single Railway service; Django + Daphne serve BOTH the API and the SPA.
# =============================================================================

# ── Stage 1: Build the React / Vite frontend ──────────────────────────────────
FROM node:20-alpine AS frontend

WORKDIR /frontend

# Install deps first (layer-cached until package-lock.json changes)
COPY package.json package-lock.json ./
RUN npm ci --include=dev

# Copy source files needed for the build
COPY index.html vite.config.js tailwind.config.js postcss.config.js ./
COPY tsconfig.json* ./
COPY src ./src
COPY public ./public

# Build for production (output → dist/)
RUN npm run build

# ── Stage 2: Compile Python wheels ───────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --wheel-dir /wheels \
        -r requirements.txt \
        gunicorn \
        daphne

# ── Stage 3: Final runtime image ─────────────────────────────────────────────
FROM python:3.11-slim AS final

# Runtime-only system libraries (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security
RUN groupadd --system appgroup && \
    useradd --system --gid appgroup --no-create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

# Install pre-built wheels
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links /wheels /wheels/*.whl && \
    rm -rf /wheels

# Copy Django application
COPY --chown=appuser:appgroup . .

# Copy the built React frontend into dist/
# Django's whitenoise WHITENOISE_ROOT will serve dist/ at the URL root
COPY --from=frontend --chown=appuser:appgroup /frontend/dist ./dist

# Collect Django static files (admin, DRF browsable API — separate from dist/)
RUN mkdir -p staticfiles && \
    SECRET_KEY=dummy-build-key \
    DEBUG=False \
    DATABASE_URL="" \
    python manage.py collectstatic --noinput 2>&1 || \
    echo "collectstatic skipped — will run at startup"

# Ensure start script is executable
RUN chmod +x /app/start.sh

USER appuser

EXPOSE 8080

# Health check via the lightweight /api/health/ endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "\
import urllib.request, sys; \
r = urllib.request.urlopen('http://localhost:8080/api/health/', timeout=8); \
sys.exit(0 if r.status == 200 else 1)"

CMD ["/app/start.sh"]
