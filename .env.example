# =============================================================================
# RemoteTeam Manager — Environment Variables Reference
# Copy this file to .env (git-ignored) and fill in real values.
#
# For Railway:  set these in the dashboard → Service → Variables.
# For Docker:   pass via docker compose environment: or --env-file .env
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here

# Set False in production — always
DEBUG=False

# Comma-separated list of allowed host headers
# Railway injects RAILWAY_PUBLIC_DOMAIN automatically — add it here too.
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app

# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL: copy the "Postgres Connection URL" from the Railway dashboard
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@localhost:5432/remoteteam

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway Redis: copy the "Redis URL" from the Railway dashboard
# Used for: Django Channels (WebSocket layer) + Celery broker + Django cache
REDIS_URL=redis://localhost:6379/0

# ── CORS & CSRF ───────────────────────────────────────────────────────────────
# For combined deployment (Railway serves both frontend + backend):
# Set to the public URL of your Railway app — same origin, no separate domain.
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# ── Frontend URL (used in emails / password-reset links) ─────────────────────
FRONTEND_URL=https://your-app.up.railway.app

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave backend as console for development (prints to terminal).
# For production use smtp.gmail.com with an App Password, or SendGrid / Mailgun.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@remoteteam.app

# ── Sentry (optional — error monitoring) ─────────────────────────────────────
# Create a free project at https://sentry.io and copy the DSN here.
SENTRY_DSN=
SENTRY_ENV=production

# ── Vite / Frontend build-time variables ─────────────────────────────────────
# Leave VITE_API_BASE_URL empty for the combined Railway deployment (same-origin /api).
# Set it only if you host the frontend on a separate domain (Netlify / Vercel):
#   VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=

# ── Local development extras ──────────────────────────────────────────────────
# Used by vite.config.js to proxy API/WS calls to a local or Docker backend.
BACKEND_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000
