# === REQUIRED ===
SECRET_KEY=your-secret-key-at-least-50-chars-long-and-random
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === OPTIONAL (Redis for WebSockets + caching) ===
# If not set, falls back to in-memory (single replica only)
REDIS_URL=redis://default:password@host:6379

# === DEPLOYMENT ===
DEBUG=False
PORT=8080
ALLOWED_HOSTS=yourapp.up.railway.app
CORS_ALLOWED_ORIGINS=https://yourfrontend.netlify.app
CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app
FRONTEND_URL=https://yourfrontend.netlify.app

# === EMAIL (optional) ===
EMAIL_HOST_USER=noreply@yourdomain.com
